meta {
  name: Get Submodel $path
  type: http
  seq: 6
}

get {
  url: {{DataEngineBaseUrl}}/shells/:aasIdentifier/submodels/:submodelIdentifier/$path
  body: none
  auth: inherit
}

params:query {
  ~level: deep
}

params:path {
  aasIdentifier: {{aasIdentifier}}
  submodelIdentifier: {{submodelIdentifierContact}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns idShort paths as strings", function () {
    expect(res.body).to.be.an('array');
    res.body.forEach(function (path) {
      expect(path).to.be.a('string');
    });
  });

  test("paths are relative to the submodel", function () {
    res.body.forEach(function (path) {
      expect(path.split(/[.\[]/)[0]).to.not.equal('ContactInformations');
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns the idShort paths (`$path`) of all submodel elements of the ContactInformation submodel.
  
  Allowed query parameter: `level` (core|deep).
}
