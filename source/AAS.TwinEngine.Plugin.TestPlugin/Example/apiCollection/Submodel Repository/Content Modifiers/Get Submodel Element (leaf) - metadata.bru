meta {
  name: Get Submodel Element (leaf) $metadata
  type: http
  seq: 18
}

get {
  url: {{DataEngineBaseUrl}}/submodels/:submodelIdentifier/submodel-elements/:idShortPath/$metadata
  body: none
  auth: inherit
}

params:path {
  submodelIdentifier: {{submodelIdentifierContact}}
  idShortPath: ContactInformation1.RoleOfContactPerson
}

assert {
  res.status: eq 200
}

tests {
  test("returns property metadata without value", function () {
    expect(res.body).to.be.an('object');
    expect(res.body).to.have.property('modelType');
    expect(res.body).to.not.have.property('value');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns the leaf Property `ContactInformation1.RoleOfContactPerson` without its `value` (`$metadata`).
}
