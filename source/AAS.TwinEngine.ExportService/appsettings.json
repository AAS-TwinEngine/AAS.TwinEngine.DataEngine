{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level}] {Message:lj} (SourceContext: {SourceContext}){NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ExportService"
    }
  },
  "AllowedHosts": "*",
  "ExportService": {
    "Scheduler": {
      "Enabled": true,
      "CronExpression": "*/5 * * * *",
      "RunTimeoutMinutes": 30
    },
    "Resilience": {
      "MaxRetryAttempts": 3,
      "InitialDelaySeconds": 2,
      "BackoffMultiplier": 2.0
    },
    "Performance": {
      "MaxDegreeOfParallelism": 10
    },
    "StateStore": {
      "ConnectionString": "Host=localhost;Port=5432;Database=exportstate;Username=postgres;Password=keval123",
      "Schema": "export_service"
    },
    "Sources": {
      "ShellDescriptors": {
        "BaseUrl": "http://localhost:8085",
        "Path": "/shell-descriptors",
        "Limit": 250,
        "Enabled": true,
        "Auth": { "Kind": "None" }
      },
      "SubmodelDescriptors": {
        "BaseUrl": "http://localhost:8085",
        "Path": "/submodel-descriptors",
        "Limit": 250,
        "Enabled": true,
        "Auth": { "Kind": "None" }
      },
      "Shells": {
        "BaseUrl": "http://localhost:8085",
        "Path": "/shells",
        "Limit": 250,
        "Enabled": true,
        "Auth": { "Kind": "None" }
      },
      "Submodels": {
        "BaseUrl": "http://localhost:8085",
        "Path": "/submodels",
        "Limit": 250,
        "Enabled": true,
        "Auth": { "Kind": "None" }
      },
      "ConceptDescriptions": {
        "BaseUrl": "http://localhost:8082",
        "Path": "/concept-descriptions",
        "Limit": 250,
        "Enabled": true,
        "Auth": { "Kind": "None" }
      }
    },
    "Targets": {
      "OmitNullProperties": true,
      "ShellDescriptors": {
        "BaseUrl": "http://localhost:8082",
        "Path": "/shell-descriptors",
        "Enabled": false,
        "Auth": { "Kind": "None" }
      },
      "SubmodelDescriptors": {
        "BaseUrl": "http://localhost:8082",
        "Path": "/submodel-descriptors",
        "Enabled": false,
        "Auth": { "Kind": "None" }
      },
      "Shells": {
        "BaseUrl": "http://localhost:8082",
        "Path": "/shells",
        "Enabled": false,
        "Auth": { "Kind": "None" }
      },
      "Submodels": {
        "BaseUrl": "http://localhost:8082",
        "Path": "/submodels",
        "Enabled": true,
        "Auth": { "Kind": "None" }
      },
      "ConceptDescriptions": {
        "BaseUrl": "http://localhost:8082",
        "Path": "/concept-descriptions",
        "Enabled": false,
        "Auth": { "Kind": "None" }
      }
    },
    "Observability": {
      "OtlpEndpoint": "http://localhost:4317",
      "ServiceName": "ExportService",
      "ServiceVersion": "1.0.0"
    }
  }
}
