  <ItemGroup>
    <ProjectReference Include="..\AAS.TwinEngine.ExportService\AAS.TwinEngine.ExportService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

