meta {
  name: Get Submodel $metadata - extent withBlobValue (400)
  type: http
  seq: 2
}

get {
  url: {{DataEngineBaseUrl}}/submodels/:submodelIdentifier/$metadata?extent=withBlobValue
  body: none
  auth: inherit
}

params:query {
  extent: withBlobValue
}

params:path {
  submodelIdentifier: {{submodelIdentifierNameplate-1}}
}

assert {
  res.status: eq 400
}

tests {
  test("rejects extent=withBlobValue on $metadata", function () {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Negative case: `$metadata` does not accept `extent=withBlobValue`. Expected HTTP 400.
}
