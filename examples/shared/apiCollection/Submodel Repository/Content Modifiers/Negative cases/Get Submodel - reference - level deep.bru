meta {
  name: Get Submodel $reference - level deep (400)
  type: http
  seq: 3
}

get {
  url: {{DataEngineBaseUrl}}/submodels/:submodelIdentifier/$reference?level=deep
  body: none
  auth: inherit
}

params:query {
  level: deep
}

params:path {
  submodelIdentifier: {{submodelIdentifierNameplate-1}}
}

assert {
  res.status: eq 400
}

tests {
  test("rejects level=deep on $reference", function () {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Negative case: `$reference` accepts `level` omitted or `core` only. Expected HTTP 400.
}
