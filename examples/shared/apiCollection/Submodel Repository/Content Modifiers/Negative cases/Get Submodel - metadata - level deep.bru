meta {
  name: Get Submodel $metadata - level deep (400)
  type: http
  seq: 1
}

get {
  url: {{DataEngineBaseUrl}}/submodels/:submodelIdentifier/$metadata?level=deep
  body: none
  auth: inherit
}

params:query {
  level: deep
}

params:path {
  submodelIdentifier: {{submodelIdentifierNameplate-1}}
}

assert {
  res.status: eq 400
}

tests {
  test("rejects the level parameter on $metadata", function () {
    expect(res.status).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Negative case: `$metadata` must not be combined with `level`. Expected HTTP 400.
}
