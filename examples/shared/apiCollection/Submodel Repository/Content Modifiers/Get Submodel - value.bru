meta {
  name: Get Submodel $value
  type: http
  seq: 6
}

get {
  url: {{DataEngineBaseUrl}}/submodels/:submodelIdentifier/$value
  body: none
  auth: inherit
}

params:query {
  ~level: deep
  ~extent: withBlobValue
}

params:path {
  submodelIdentifier: {{submodelIdentifierNameplate-1}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns a plain value object", function () {
    expect(res.body).to.be.an('object');
    expect(res.body).to.not.have.property('modelType');
    expect(res.body).to.not.have.property('idShort');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns the value-only representation of the Nameplate submodel (`$value`): a plain object keyed by element idShort, without `modelType` or `idShort` metadata.
  
  Allowed query parameters: `level` (core|deep), `extent` (withoutBlobValue|withBlobValue).
}
