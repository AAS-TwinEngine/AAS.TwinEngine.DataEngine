meta {
  name: Get Submodel Element $reference
  type: http
  seq: 15
}

get {
  url: {{DataEngineBaseUrl}}/submodels/:submodelIdentifier/submodel-elements/:idShortPath/$reference
  body: none
  auth: inherit
}

params:query {
  ~level: core
}

params:path {
  submodelIdentifier: {{submodelIdentifierNameplate-1}}
  idShortPath: AddressInformation
}

assert {
  res.status: eq 200
}

tests {
  test("returns an element model reference", function () {
    expect(res.body.type).to.equal('ModelReference');
    expect(res.body.keys).to.be.an('array').that.is.not.empty;
    expect(res.body.keys[0].type).to.equal('Submodel');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns a model reference (`$reference`) to the `AddressInformation` collection: first key is the submodel, followed by the element key.
  
  `level` may be omitted or `core`; `level=deep` is rejected with HTTP 400.
}
