          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/000-001/Nameplate\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/000-001/CarbonFootprint\")"
          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/000-001/CarbonFootprint\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/000-002/Nameplate\")"
          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/000-002/Nameplate\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/000-002/CarbonFootprint\")"
          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/000-002/CarbonFootprint\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/001-001/Nameplate\")"
          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/001-001/Nameplate\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/001-001/CarbonFootprint\")"
          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/001-001/CarbonFootprint\")"
          }
        ]
      },
      {
        "name": "viewer_identifiables",
        "objects": [
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/000-001/MaintenanceInstructions\")"
          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/000-001/MaintenanceInstructions\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/000-001/TechnicalData\")"
          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/000-001/TechnicalData\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/000-002/MaintenanceInstructions\")"
          },
          {
            "DESCRIPTOR": "$smdesc(\"https://mm-software.com/submodel/000-002/MaintenanceInstructions\")"
          },
          {
            "IDENTIFIABLE": "$sm(\"https://mm-software.com/submodel/000-002/TechnicalData\")"
          },
          {
